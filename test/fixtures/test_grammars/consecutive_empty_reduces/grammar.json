{
  "name": "consecutive_empty_reduces",
  "rules": {
    "declaration": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "identifier"
        },
        {
          "type": "SYMBOL",
          "name": "int_opt"
        },
        {
          "type": "SYMBOL",
          "name": "alias"
        }
      ]
    },
    "int_opt": {
      "type": "CHOICE",
      "members": [
        {
          "type": "BLANK"
        },
        {
          "type": "SYMBOL",
          "name": "number"
        }
      ]
    },
    "alias": {
      "type": "CHOICE",
      "members": [
        {
          "type": "BLANK"
        },
        {
          "type": "SYMBOL",
          "name": "tag"
        }
      ]
    },
    "identifier": {
      "type": "PATTERN",
      "value": "[a-z]+"
    },
    "number": {
      "type": "PATTERN",
      "value": "[0-9]+"
    },
    "tag": {
      "type": "PATTERN",
      "value": "<[^>]*>"
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    }
  ]
}
