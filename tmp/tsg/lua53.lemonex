/*
** 11_lua53.y -- Lua 5.3 grammar, translated from lua-5.3.g
**
** The source (lua-5.3.g, in the repository root) is a Bison+Flex
** amalgamation by Robert van Engelen.  This file is the Lemonex
** translation, generated by hand.
**
** Translation notes
** -----------------
**  * Bison's default rule precedence is the *last* terminal on the RHS;
**    Lemon uses the *left-most* terminal with a precedence.  For every
**    binary rule "exp OP exp" the two agree (OP is the only terminal),
**    so only the two unary rules that Bison marks with "%prec NOT" need
**    Lemon's "[NOT]" precedence mark.
**  * Bison/Flex character tokens such as '<' have no Lemon equivalent, so
**    each single-character operator gets a named terminal (LT, PLUS, ...).
**  * The Flex start conditions LONGCOMMENT and LONGSTRING become
**    %lexer_mode sections with [NAME] / [<] switches.
**  * Flex {name} definitions (digit, alpha, integer, exp, float, string,
**    longbracket) are expanded into Lemonex regexes.
**  * The original Flex rules "--".* and {longbracket} rely on Flex's
**    longest-match rule, which actually shadows the long-comment opener
**    when text follows on the same line.  Here the line-comment rules are
**    split so that "--[[ ... ]]" and "--[=[ ... ]=]" are recognised as
**    long comments while "-- text", "--[x", "--[]" stay line comments.
**
** Build:
**   ../../lemon.osx T=../../lempar.c d=. 11_lua53.y
**   cc -std=c99 -o lua53 11_lua53.c && ./lua53
*/
%include {
#include <assert.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
}

%start_symbol chunk

/* ---------------- precedence: lowest first ---------------- */

%left OR.
%left AND.
%left EQU NEQ LTE GTE LT GT.
%left PIPE.
%left TILDE.
%left AMP.
%left SHL SHR.
%right CAT.
%left PLUS MINUS.
%left DIV PERCENT STAR SLASH.
%right NOT HASH.
%right CARET.
/* Highest precedence, used only to force the shift of '(' when a
** prefix expression is followed by an argument list (function call).
** Those shift/reduce conflicts are benign (greedy call wins). */
%right LPAREN.

/* ---------------- grammar ---------------- */
/*
** NOTE: this Lemon fork has no %token directive.  Terminals are created
** automatically the first time they are used, in the order they appear.
** The precedence tokens are created by the %left/%right lines above.
*/

chunk ::= block.

semi ::= SEMI.
semi ::= .

block ::= scope statlist.
block ::= scope statlist laststat semi.

scope ::= .
scope ::= scope statlist binding semi.

statlist ::= .
statlist ::= statlist stat semi.

stat ::= DO block END.
stat ::= IF conds END.
stat ::= WHILE exp DO block END.
stat ::= REPEAT block UNTIL exp.
stat ::= FOR NAME ASSIGN explist2 DO block END.
stat ::= FOR namelist IN exprlist DO block END.
stat ::= FUNCTION funcname funcbody.
stat ::= GOTO NAME.
stat ::= label.
stat ::= setlist ASSIGN exprlist.
stat ::= funccall. [LPAREN]

conds ::= condlist.
conds ::= condlist ELSE block.

condlist ::= cond.
condlist ::= condlist ELSEIF cond.

cond ::= exp THEN block.

laststat ::= BREAK.
laststat ::= RETURN.
laststat ::= RETURN exprlist.

label ::= COLS NAME COLS.

binding ::= LOCAL namelist.
binding ::= LOCAL namelist ASSIGN exprlist.
binding ::= LOCAL FUNCTION NAME funcbody.

funcname ::= dottedname.
funcname ::= dottedname COLON NAME.

dottedname ::= NAME.
dottedname ::= dottedname DOT NAME.

namelist ::= NAME.
namelist ::= namelist COMMA NAME.

exprlist ::= exp.
exprlist ::= exprlist COMMA exp.

explist2 ::= exp COMMA exp.
explist2 ::= exp COMMA exp COMMA exp.

exp ::= NIL.
exp ::= TRUE.
exp ::= FALSE.
exp ::= INTEGER.
exp ::= FLOAT.
exp ::= STRING.
exp ::= DOTS.
exp ::= function.
exp ::= table.
exp ::= var. [LPAREN]
exp ::= funccall. [LPAREN]
exp ::= NOT exp.
exp ::= HASH exp.
exp ::= MINUS exp. [NOT]
exp ::= TILDE exp. [NOT]
exp ::= exp OR exp.
exp ::= exp AND exp.
exp ::= exp LT exp.
exp ::= exp LTE exp.
exp ::= exp GT exp.
exp ::= exp GTE exp.
exp ::= exp EQU exp.
exp ::= exp NEQ exp.
exp ::= exp PIPE exp.
exp ::= exp TILDE exp.
exp ::= exp AMP exp.
exp ::= exp SHL exp.
exp ::= exp SHR exp.
exp ::= exp CAT exp.
exp ::= exp PLUS exp.
exp ::= exp MINUS exp.
exp ::= exp STAR exp.
exp ::= exp SLASH exp.
exp ::= exp DIV exp.
exp ::= exp PERCENT exp.
exp ::= exp CARET exp.
exp ::= LPAREN exp RPAREN. [LPAREN]

setlist ::= var.
setlist ::= setlist COMMA var.

var ::= NAME.
var ::= var LBRACKET exp RBRACKET.
var ::= var DOT NAME.
var ::= funccall LBRACKET exp RBRACKET.
var ::= funccall DOT NAME.
var ::= LPAREN exp RPAREN LBRACKET exp RBRACKET.
var ::= LPAREN exp RPAREN DOT NAME.

funccall ::= var args.
funccall ::= var COLON NAME args.
funccall ::= funccall args.
funccall ::= funccall COLON NAME args.
funccall ::= LPAREN exp RPAREN args.
funccall ::= LPAREN exp RPAREN COLON NAME args.

args ::= LPAREN RPAREN.
args ::= LPAREN exprlist RPAREN.
args ::= table.
args ::= STRING.

function ::= FUNCTION funcbody.

funcbody ::= params block END.

params ::= LPAREN parlist RPAREN.

parlist ::= .
parlist ::= namelist.
parlist ::= DOTS.
parlist ::= namelist COMMA DOTS.

table ::= LBRACE RBRACE.
table ::= LBRACE fieldlist RBRACE.
table ::= LBRACE fieldlist COMMA RBRACE.
table ::= LBRACE fieldlist SEMI RBRACE.

fieldlist ::= field.
fieldlist ::= fieldlist COMMA field.
fieldlist ::= fieldlist SEMI field.

field ::= exp.
field ::= NAME ASSIGN exp.
field ::= LBRACKET exp RBRACKET ASSIGN exp.

/* ============================ lexer ============================ */

WS ::= "[\r\n\t ]+".

/* ----- comments ----- */
LONGCOMMENT_OPEN  ::= "--\[=*\[". [LONGCOMMENT]
LINE_COMMENT      ::= "--[^\[\n][^\n]*".
LINE_COMMENT_BR   ::= "--\[=*[^=\[\n][^\n]*".
LINE_COMMENT_END  ::= "--\[=*".
LINE_COMMENT_BARE ::= "--".

/* ----- keywords (before NAME so they win ties) ----- */
AND      ::= "and".
BREAK    ::= "break".
DO       ::= "do".
ELSE     ::= "else".
ELSEIF   ::= "elseif".
END      ::= "end".
FALSE    ::= "false".
FOR      ::= "for".
FUNCTION ::= "function".
GOTO     ::= "goto".
IF       ::= "if".
IN       ::= "in".
LOCAL    ::= "local".
NIL      ::= "nil".
NOT      ::= "not".
OR       ::= "or".
REPEAT   ::= "repeat".
RETURN   ::= "return".
THEN     ::= "then".
TRUE     ::= "true".
UNTIL    ::= "until".
WHILE    ::= "while".

/* ----- multi-character operators ----- */
EQU    ::= "==".
NEQ    ::= "~=".
LTE    ::= "<=".
GTE    ::= ">=".
SHL    ::= "<<".
SHR    ::= ">>".
DIV    ::= "//".
CAT    ::= "\.\.".
DOTS   ::= "\.\.\.".
COLS   ::= "::".

/* ----- long string opener ----- */
LONGSTRING_OPEN ::= "\[=*\[". [LONGSTRING]

/* ----- single-character operators ----- */
HASH     ::= "#".
PERCENT  ::= "%".
AMP      ::= "&".
LPAREN   ::= "\(".
RPAREN   ::= "\)".
STAR     ::= "\*".
PLUS     ::= "\+".
COMMA    ::= ",".
MINUS    ::= "-".
DOT      ::= "\.".
SLASH    ::= "/".
COLON    ::= ":".
SEMI     ::= ";".
LT       ::= "<".
ASSIGN   ::= "=".
GT       ::= ">".
LBRACKET ::= "\[".
RBRACKET ::= "\]".
CARET    ::= "\^".
LBRACE   ::= "\{".
PIPE     ::= "\|".
RBRACE   ::= "\}".
TILDE    ::= "~".

/* ----- identifiers, numbers, short strings ----- */
NAME    ::= "[a-zA-Z_][a-zA-Z_0-9]*".
INTEGER ::= "[\d]+|0[xX][0-9a-fA-F]+".
FLOAT   ::= "[\d]+\.[\d]*([eE][+\-]?[\d]+)?".
STRING  ::= "\"(\\.|[^\"\\\n])*\"|'(\\.|[^'\\\n])*'".

/* ---------------- LONGCOMMENT mode ---------------- */
%lexer_mode LONGCOMMENT.
COMMENT_END ::= "\]=*\]". [<]
COMMENT_ANY ::= "(.|\n)".

/* ---------------- LONGSTRING mode ---------------- */
%lexer_mode LONGSTRING.
STRING      ::= "\]=*\]". [<]
LONGSTR_ANY ::= "(.|\n)".

/* ============================ driver ============================ */

%syntax_error { printf("  !! syntax error\n"); }

%code {
static const char *lua_sample =
  "-- a line comment\n"
  "--[[ a long\n"
  "     comment ]]\n"
  "local x = 1 + 2 * 3 ^ 2 - -4\n"
  "local s = [[hello\nworld]]\n"
  "local t = { 1, 2, name = \"x\", [3] = 4; }\n"
  "function f(a, b, ...) return a + b end\n"
  "for i = 1, 10 do x = x + 1 end\n"
  "for k, v in pairs(t) do x = k end\n"
  "while x < 10 do x = x + 1 end\n"
  "repeat x = x - 1 until x == 0\n"
  "if x then x = 1 elseif x == 0 then x = 2 else x = 3 end\n"
  "::top:: goto top\n"
  "local a, b = f(1, 2), {1,2,3}\n"
  "t.x, t[1] = 10, 20\n"
  "print(\"done\", 1 // 2, x & 3 | 4 ~ 5 << 1)\n";

int main(int argc, char **argv){
  int rc;
  if( argc > 1 ){
    printf("---- %s ----\n", argv[1]);
    rc = ParseReadFile(argv[1], 0);
  }else{
    printf("---- built-in sample ----\n%s\n", lua_sample);
    rc = ParseReadString((char*)lua_sample, "<lua>", 0);
  }
  printf("%s\n", rc == 0 ? "OK" : "FAILED");
  return rc != 0;
}
}
