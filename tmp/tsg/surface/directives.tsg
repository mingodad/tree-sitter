// Every directive form the compiler accepts, once, in the spelling it accepts.
//
// selfhost.sh compiles this file and parses it with the parser built from
// examples/tsg.tsg; together with `expressions.tsg` it must exercise every named
// node in that grammar's node-types.json, so a construct the front end grows
// without teaching the language description shows up as a failure.

%name directives;
%inherits base;
%word KEYWORD;
%extra /[ \t\r\n]+/;
%extra comment;
%external EXTERNAL;
%inline _inlined;
%supertypes super_a super_b;
%supertype super_a;
%conflicts conflict_a conflict_b;

// An ordering list: names comparable with each other and nothing else. This is
// the form `--from-json` emits.
%precedences "order_high" "order_low";

// Levels, highest first: associativity, the terminals that inherit the level,
// a level that owns no terminals, and the explicit `= ;` spelling of the same.
%precedence right "pow" = '^';
%precedence left "add" = '+' '-' KEYWORD;
%precedence right "call";
%precedence "unary" = ;

// `= ;` is an explicitly empty word set, which `js` needs.
%reserved keywords = 'if', 'else', KEYWORD;
%reserved empty = ;

// The start rule is the one place emptiness is allowed.
start: super_a | conflict_a | 'if' | 'else' | ();

_body:
    KEYWORD
  | EXTERNAL
  | '^'
  | _body '+' _body @left(add)
  | _body '-' _body @unary
  | '(' _body ')'
  | $field
  | call_forms;

// The call form, all of it: every function, `.`-qualified names, immediate
// tokens, a trailing comma, and a regex with the one flag that has an effect.
call_forms:
    seq(_inlined, optional('x'), repeat('y'), repeat1('z'), super_b,)
  | seq(blank(), 'a', choice('b', prec(1, 'c'), prec.left(2, 'd'), prec.right(3, 'e'), prec.dynamic(4, 'f')))
  | seq((), 'g', token('h') token.immediate('i'))
  | seq(field('name', 'j'), alias('k', 'l'), sym(an_ident), reserved(keywords, 'if'))
  | seq(token(/m/), /n/i);

KEYWORD: /[A-Z]+/;
EXTERNAL: /[0-9]+/;
super_a: 'A';
super_b: 'B';
conflict_a: 'C';
conflict_b: 'D';
_inlined: 'E';
field: 'F';
an_ident: /[a-z]+/;
comment: /\/\/[^\n]*/;
