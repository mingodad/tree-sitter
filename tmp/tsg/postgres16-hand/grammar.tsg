  XMLROOT: /XMLROOT/i;
  XMLSERIALIZE: /XMLSERIALIZE/i;
  XMLTABLE: /XMLTABLE/i;
  YEAR_P: /YEAR/i;
  YES_P: /YES/i;
  ZONE: /ZONE/i;
  MODE_TYPE_NAME: /MODE_TYPE_NAME/i;
  MODE_PLPGSQL_EXPR: /MODE_PLPGSQL_EXPR/i;
  MODE_PLPGSQL_ASSIGN1: /MODE_PLPGSQL_ASSIGN1/i;
  MODE_PLPGSQL_ASSIGN2: /MODE_PLPGSQL_ASSIGN2/i;
  MODE_PLPGSQL_ASSIGN3: /MODE_PLPGSQL_ASSIGN3/i;
  FCONST: /([0-9]*\.[0-9]+|[0-9]+\.[0-9]*)([Ee][-+]?[0-9]+)?/;
  SCONST: /'((''|[^']))*'/;
  Op: /(\|\||->>|->|#>>|#>|@>|<@|\?\||\?&|\?)/;
  ICONST: /[0-9]+/;
  PARAM: /\$[0-9]+/;
  TYPECAST: /(::)/;
  COLON_EQUALS: /(:=)/;
  EQUALS_GREATER: /(=>)/;
  LESS_EQUALS: /(<=)/;
  GREATER_EQUALS: /(>=)/;
  NOT_EQUALS: /!=|<>/;
  IDENT: /([A-Za-z\x80-\xff_][A-Za-z\x80-\xff_0-9$]*|\"((\"\"|[^\"]))*\")/;
