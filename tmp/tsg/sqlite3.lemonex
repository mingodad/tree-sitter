WITH ::= "WITH".
WITHOUT ::= "WITHOUT".
FLOAT ::= "([0-9]+\.[0-9]*|\.[0-9]+)([Ee](\+|\-)?[0-9]+)?".
INTEGER ::= "[0-9]+".
STRING ::= "'(''|[^'\n])*'".
ID ::= "[_a-zA-Z][a-zA-Z0-9_]*|\"[_a-zA-Z][a-zA-Z0-9_]*\"".

/* ============================ driver ============================ */

%syntax_error { printf("  !! syntax error\n"); }

%code {
static const char *sql_sample =
  "CREATE TABLE t(a INTEGER PRIMARY KEY, b TEXT);\n"
  "INSERT INTO t(a,b) VALUES(1,'one'),(2,'two');\n"
  "SELECT a, b FROM t WHERE a > 1 ORDER BY b DESC;\n"
  "UPDATE t SET b='x' WHERE a=1;\n"
  "DELETE FROM t WHERE a=2;\n"
  "SELECT count(*) AS n FROM t;\n";

int main(int argc, char **argv){
  int rc;
  if( argc > 1 ){
    printf("---- %s ----\n", argv[1]);
    rc = ParseReadFile(argv[1], 0);
  }else{
    printf("---- built-in sample ----\n%s\n", sql_sample);
    rc = ParseReadString((char*)sql_sample, "<sql>", 0);
  }
  printf("%s\n", rc == 0 ? "OK" : "FAILED");
  return rc != 0;
}
}
