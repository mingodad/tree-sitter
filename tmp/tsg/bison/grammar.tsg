// A tree-sitter grammar translated from bison.g.
// Translated by g2tsg from bison.g (read with bison_flex/grammar.tsg).

%name bison;
%start input;

// Flex start condition `ACTION_CODE`: one token for the whole region.
%external ACTION_CODE = delimited('{', '}');

tokens {
  STRING: /("(\\.|[^"\n\r\\])*")/;
  TSTRING: /_\(("(\\.|[^"\n\r\\])*")\)/;
  BRACKETED_ID: /\[([a-zA-Z_][a-zA-Z_.0-9-]*)\]/;
  CHAR_LITERAL: /'(\\.|[^'\n\r\\])'/;
  ID: /([a-zA-Z_][a-zA-Z_.0-9-]*)/;
  ID_COLON: /([a-zA-Z_][a-zA-Z_.0-9-]*)[[:space:]]*:/;
  TAG: /<[^>]*>/;
  INT_LITERAL: /[0-9]+/;
  SECTION_MARK: /%%/;
  VERBATIN_CODE: /(%\{(?s:.)*?%\})/;
}

%extra /([ \t\r\n]+)/;
%extra /(\/\/[^\r\n]*)/;
%extra /([\/][*](?s:.)*?[*][\/])/;

// Bison lists precedence lowest first; tsg wants the descending chain.
// `nonassoc` becomes a level with no associativity (see the notes above).


// Bison named the start symbol with `%start`.
// The start rule is written first.

input:
    prologue_declaration* SECTION_MARK rules_or_grammar_declaration+ epilogue= SECTION_MARK?;

prologue_declaration:
    grammar_declaration
  | VERBATIN_CODE
  | "%<flag>"
  | "%define" ID value= (ID | STRING | ACTION_CODE)?
  | "%header" string= STRING?
  | "%error-verbose"
  | "%expect" INT_LITERAL
  | "%expect-rr" INT_LITERAL
  | "%file-prefix" STRING
  | "%glr-parser"
  | "%initial-action" ACTION_CODE
  | "%language" STRING
  | "%name-prefix" STRING
  | "%no-lines"
  | "%nondeterministic-parser"
  | "%output" STRING
  | "%param" ACTION_CODE+
  | "%pure-parser"
  | "%require" STRING
  | "%skeleton" STRING
  | "%token-table"
  | "%verbose"
  | "%yacc"
  | ';';

grammar_declaration:
    symbol_declaration
  | "%start" symbol+
  | code_props_type ACTION_CODE generic_symlist_item+
  | "%default-prec"
  | "%no-default-prec"
  | "%code" ID? ACTION_CODE
  | "%union" union_name= ID? ACTION_CODE;

code_props_type:
    "%destructor"
  | "%printer";

symbol_declaration:
    "%nterm" token_decls
  | "%token" token_decls
  | "%type" symbol_decls
  | precedence_declarator token_decls_for_prec;

precedence_declarator:
    "%left"
  | "%right"
  | "%nonassoc"
  | "%precedence";

generic_symlist_item:
    symbol
  | TAG;

token_decls:
    TAG? token_decl+ (TAG token_decl+)*;

token_decl:
    id int_opt? alias= (string_as_id | TSTRING)?;

int_opt:
    INT_LITERAL;

token_decls_for_prec:
    TAG? token_decl_for_prec+ (TAG token_decl_for_prec+)*;

token_decl_for_prec:
    id int_opt?
  | string_as_id;

symbol_decls:
    TAG? symbol+ (TAG symbol+)*;

rules_or_grammar_declaration:
    rules
  | grammar_declaration ';';

rules:
    id_colon (named_ref_opt? ':')? rhs ('|' rhs | ';')*;

rhs:
    (symbol named_ref_opt? | tag= TAG? ACTION_CODE named_ref_opt? | "%?{...}" | "%empty" | "%prec" symbol | "%dprec" INT_LITERAL | "%merge" TAG | "%expect" INT_LITERAL | "%expect-rr" INT_LITERAL)*;

named_ref_opt:
    BRACKETED_ID;

id:
    ID
  | CHAR_LITERAL;

id_colon:
    ID_COLON;

symbol:
    id
  | string_as_id;

string_as_id:
    STRING;
