--- a/crates/generate/src/generate.rs
+++ b/crates/generate/src/generate.rs
@@ -286,11 +286,55 @@ pub enum Diagnostic {
     SupertypeInlined { name: Box<str> },
     UnreachableRule { name: Box<str> },
