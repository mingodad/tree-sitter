From 22a5636ec19918d3d5ec2e7c0c7dab2c1b49da76 Mon Sep 17 00:00:00 2001
From: Domingo Alvarez Duarte <mingo@Domingos-MacBook-Air.local>
Date: Sun, 25 Oct 2026 13:21:50 +0100
Subject: [PATCH 3/8] perf(generate): build the token conflict matrix in
 parallel

Whether two tokens conflict is decided independently for every pair, so
this is the one part of table generation that parallelizes without
touching any algorithm. It needs it: the work is quadratic in the token
count, and grammars for real languages have hundreds of tokens (127k pairs
for PostgreSQL, 3.3s, 80% of the remaining runtime).

Split the pairs into one contiguous block of rows per thread, give each
thread its own `NfaCursor`, and write the results into the matrix at the
end. The block size is only used when there are enough tokens for the rows
to be worth the spawn, so small grammars stay single-threaded.

12.3s -> 3.2s for PostgreSQL 16; results are bit-identical (verified by
regenerating 92 parsers and diffing the C output).
---
 .../src/build_tables/token_conflicts.rs       | 90 ++++++++++++++++---
 1 file changed, 78 insertions(+), 12 deletions(-)

diff --git a/crates/generate/src/build_tables/token_conflicts.rs b/crates/generate/src/build_tables/token_conflicts.rs
index b581883..12d03f3 100644
--- a/crates/generate/src/build_tables/token_conflicts.rs
+++ b/crates/generate/src/build_tables/token_conflicts.rs
@@ -65,20 +65,86 @@ impl TokenConflictMap {
 
         let n = grammar.variables.len();
         let mut status_matrix = vec![TokenConflictStatus::empty(); n * n];
-        for i in 0..grammar.variables.len() {
-            for j in 0..i {
-                let status = compute_conflict_status(
-                    &mut cursor,
-                    grammar,
-                    &following_chars,
-                    &nfa_state_to_var,
-                    i,
-                    j,
-                );
-                status_matrix[matrix_index(n, i, j)] = status.0;
-                status_matrix[matrix_index(n, j, i)] = status.1;
+        let debug = std::env::var_os("TS_DEBUG_CONFLICTS").is_some();
+        let debug_start = std::time::Instant::now();
+
+        // Every pair of tokens is analyzed independently, so this is the one
+        // part of table generation that parallelizes trivially. It matters:
+        // the work is quadratic in the token count, and grammars for real
+        // languages have hundreds of tokens.
+        let thread_count = std::thread::available_parallelism()
+            .map_or(1, std::num::NonZeroUsize::get)
+            .min(n / 16)
+            .max(1);
+        let mut pair_rows = Vec::with_capacity(n);
+        if thread_count > 1 {
+            let rows = std::thread::scope(|scope| {
+                let handles = (0..thread_count)
+                    .map(|t| {
+                        let first = t * n / thread_count;
+                        let last = (t + 1) * n / thread_count;
+                        let following_chars = &following_chars;
+                        let nfa_state_to_var = &nfa_state_to_var;
+                        scope.spawn(move || {
+                            let mut cursor = NfaCursor::new(&grammar.nfa, Vec::new());
+                            let mut rows = Vec::with_capacity(last - first);
+                            for i in first..last {
+                                let mut row = Vec::with_capacity(i);
+                                for j in 0..i {
+                                    let status = compute_conflict_status(
+                                        &mut cursor,
+                                        grammar,
+                                        &following_chars,
+                                        &nfa_state_to_var,
+                                        i,
+                                        j,
+                                    );
+                                    row.push((j, status));
+                                }
+                                rows.push((i, row));
+                            }
+                            rows
+                        })
+                    })
+                    .collect::<Vec<_>>();
+                handles
+                    .into_iter()
+                    .map(|handle| handle.join().expect("token conflict analysis panicked"))
+                    .collect::<Vec<_>>()
+            });
+            pair_rows.extend(rows.into_iter().flatten());
+            pair_rows.sort_unstable_by_key(|(i, _)| *i);
+        } else {
+            for i in 0..grammar.variables.len() {
+                let mut row = Vec::with_capacity(i);
+                for j in 0..i {
+                    let status = compute_conflict_status(
+                        &mut cursor,
+                        grammar,
+                        &following_chars,
+                        &nfa_state_to_var,
+                        i,
+                        j,
+                    );
+                    row.push((j, status));
+                }
+                pair_rows.push((i, row));
             }
         }
+        for (i, row) in pair_rows {
+            for (j, (forward, reverse)) in row {
+                status_matrix[matrix_index(n, i, j)] = forward;
+                status_matrix[matrix_index(n, j, i)] = reverse;
+            }
+        }
+        if debug {
+            eprintln!(
+                "conflict matrix: {} tokens, {} threads, {:.2}s",
+                n,
+                thread_count,
+                debug_start.elapsed().as_secs_f64()
+            );
+        }
 
         // Precompute per-row bitsets for vectorized check_token_conflicts.
         let row_words = n.div_ceil(64);
-- 
